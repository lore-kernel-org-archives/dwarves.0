> > +       int32_t i, id;
> > +       struct btf_var_secinfo *vsi;
> > +
> > +       for (i = 0; i < nr_var_secinfo; i++) {
> > +               vsi = (struct btf_var_secinfo *)var_secinfo_buf->entries + i;
